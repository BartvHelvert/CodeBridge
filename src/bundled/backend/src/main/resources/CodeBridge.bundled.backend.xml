<idea-plugin>
    <dependencies>
        <module name="intellij.platform.backend"/>
        <module name="CodeBridge.backend" namespace="codebridge"/>
        <module name="CodeBridge.shared" namespace="codebridge"/>
    </dependencies>
    <extensionPoints>
        <!-- A VS Code extension another plugin ships, so that plugin can be published as the
             extension itself. Public: the extension point the plugins made from extensions use. -->
        <extensionPoint qualifiedName="me.helvert.codebridge.bundledExtension"
                        beanClass="me.helvert.codebridge.bundled.BundledExtensionBean" dynamic="true"/>
    </extensionPoints>
    <extensions defaultExtensionNs="me.helvert.codebridge">
        <extensionSource implementation="me.helvert.codebridge.bundled.BundledExtensionSource"/>
    </extensions>
</idea-plugin>
