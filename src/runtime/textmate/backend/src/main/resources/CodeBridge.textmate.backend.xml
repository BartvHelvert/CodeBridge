<idea-plugin>
    <dependencies>
        <!-- Backend-only in its own right, not just through `CodeBridge.backend`. -->
        <module name="intellij.platform.backend"/>
        <module name="CodeBridge.backend"/>
        <module name="CodeBridge.shared"/>
        <plugin id="org.jetbrains.plugins.textmate"/>
        <module name="intellij.textmate"/>
    </dependencies>
    <extensions defaultExtensionNs="com.intellij">
        <textmate.bundleProvider implementation="me.helvert.codebridge.textmate.CodeBridgeTextMateBundles"/>
        <enterBetweenBracesDelegate language="textmate"
                                    implementationClass="me.helvert.codebridge.textmate.CodeBridgeTextMateEnterBetweenBraces"/>
    </extensions>
    <extensions defaultExtensionNs="me.helvert.codebridge">
        <fileLanguage implementation="me.helvert.codebridge.textmate.CodeBridgeTextMateFileLanguage"/>
    </extensions>
</idea-plugin>
