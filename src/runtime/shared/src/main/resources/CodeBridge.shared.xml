<!-- Internal: CodeBridge's modules, in the same namespace, build on this one. -->
<idea-plugin visibility="internal">
    <dependencies>
        <module name="intellij.platform.rpc"/>
        <module name="intellij.platform.project"/>
        <!-- `VirtualFileId`, which names a backend file to the frontend that opens it. -->
        <module name="intellij.platform.ide.impl"/>
        <module name="CodeBridge.protocol"/>
        <!-- Not `intellij.platform.analysis.impl`, whose `frontendFriendlyInsertHandler` point the
             extension below registers with: it is part of the core rather than a content module,
             so it cannot be depended on, and declaring it keeps the whole plugin from loading. -->
    </dependencies>

    <extensionPoints>
        <!-- Registered by the full plugin's workspace module: that VS Code's own files apply. -->
        <extensionPoint qualifiedName="me.helvert.codebridge.vsCodeFiles"
                        beanClass="me.helvert.codebridge.workspace.VsCodeFilesBean" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Which `.code-workspace` file each project is opened with, as the user chose. -->
        <applicationService serviceImplementation="me.helvert.codebridge.workspace.WorkspaceChoices"/>
        <!-- Serializable, so a completion's insertion runs on the client instead of a round trip later. -->
        <completion.frontendFriendlyInsertHandler target="me.helvert.codebridge.completion.CodeBridgeInsertHandler"/>
        <!-- A launch.json template, inserted whole with its first placeholder selected. -->
        <completion.frontendFriendlyInsertHandler target="me.helvert.codebridge.completion.CodeBridgeJsonEntryInsertHandler"/>
        <completion.frontendFriendlyInsertHandler target="me.helvert.codebridge.completion.CodeBridgeCommandInsertHandler"/>
        <completion.frontendFriendlyInsertHandler target="me.helvert.codebridge.completion.CodeBridgeVariableInsertHandler"/>
    </extensions>
</idea-plugin>
